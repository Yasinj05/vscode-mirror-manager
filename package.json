{
  "name": "mirror-manager",
  "displayName": "Mirror Manager",
  "description": "Intelligent management of package mirrors for npm, pip, docker, git, apt and more",
  "version": "0.0.1",
  "publisher": "Yasin Jafari",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mirror-manager.switchToFastest",
        "title": "Mirror Manager: Switch to Fastest Mirror"
      },
      {
        "command": "mirror-manager.showStatus",
        "title": "Mirror Manager: Show Status"
      },
      {
        "command": "mirror-manager.diagnose",
        "title": "Mirror Manager: Diagnose"
      },
      {
        "command": "mirror-manager.selectManually",
        "title": "Mirror Manager: Select Mirror Manually"
      },
      {
        "command": "mirror-manager.refreshList",
        "title": "Mirror Manager: Refresh Mirrors List"
      },
      {
        "command": "mirror-manager.disable",
        "title": "Mirror Manager: Disable"
      }
    ],
    "configuration": {
      "title": "Mirror Manager",
      "properties": {
        "mirror-manager.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the extension"
        },
        "mirror-manager.autoSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch to a better mirror if current one is slow or unavailable"
        },
        "mirror-manager.autoCheckInterval": {
          "type": "number",
          "default": 30,
          "description": "Interval between automatic health checks (in minutes)"
        },
        "mirror-manager.timeout": {
          "type": "number",
          "default": 10000,
          "description": "Timeout for mirror testing in milliseconds"
        },
        "mirror-manager.integrations": {
          "type": "object",
          "default": {
            "npm": true,
            "pip": true,
            "docker": true,
            "git": true,
            "apt": false,
            "maven": false,
            "go": false,
            "composer": false,
            "nuget": false
          },
          "description": "Enable/disable integration with each tool"
        },
        "mirror-manager.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Log level for the extension"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "test": "npm run compile-tests && mocha out/test/**/*.test.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/chai": "^4.3.5",
    "@types/fs-extra": "^11.0.1",
    "@types/lodash": "^4.14.195",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.x",
    "@types/sinon": "^10.0.15",
    "@types/vscode": "^1.70.0",
    "@types/yaml": "^1.9.7",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "chai": "^4.3.7",
    "eslint": "^8.50.0",
    "mocha": "^10.2.0",
    "sinon": "^15.2.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "chalk": "^4.1.2",
    "fs-extra": "^11.1.1",
    "lodash": "^4.17.21",
    "yaml": "^2.3.2"
  }
}
